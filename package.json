{
  "name": "5minute-study",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "android:sync": "node -e \"const fs=require('fs');fs.mkdirSync('android',{recursive:true});fs.copyFileSync('twa-manifest.json','android/twa-manifest.json')\"",
    "android:build": "npm run android:sync && cd android && bubblewrap update --skipVersionUpgrade && bubblewrap build",
    "android:release": "npm run android:sync && cd android && bubblewrap update && bubblewrap build",
    "android:fingerprint": "cd android && bubblewrap fingerprint list",
    "android:install": "cd android && bubblewrap install"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
